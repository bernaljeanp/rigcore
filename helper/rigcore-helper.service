[Unit]
Description=Rigcore - servicio de control de hardware
Documentation=https://github.com/bernaljeanp/rigcore

[Service]
Type=dbus
BusName=io.github.bernaljeanp.Rigcore.Helper
ExecStart=/usr/bin/python3 -I @LIBEXECDIR@/rigcore-helper
Restart=on-failure

# Aislamiento: sin red, sin /home, sistema en solo lectura (salvo /sys, /proc, /dev).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE
UMask=0077
StateDirectory=rigcore
# Luces: acceso al controlador USB HID.
DeviceAllow=char-hidraw rw

[Install]
WantedBy=multi-user.target
